# ------------------------------------------------------------------ #
# Python
# ------------------------------------------------------------------ #
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# ------------------------------------------------------------------ #
# Generated artefacts (re-created by `python main.py run`)
# ------------------------------------------------------------------ #
data/source_data.csv
models/*.pkl
models/*.joblib
reports/*.html
reports/*.csv
reports/*.json
catboost_info/
diag*.py
diag*.txt
run_tests.txt
test_run.txt
app_tests.txt

# Keep the folder placeholders inside the ignored folders
!models/.gitkeep
!reports/.gitkeep
!data/raw/.gitkeep

# ------------------------------------------------------------------ #
# Vercel deployment (docs/deployment-vercel.md)
# ------------------------------------------------------------------ #
# `public/` is produced by `python scripts/prepare_vercel_site.py` - on Vercel
# itself it is rebuilt during the build step, so it never belongs in git.
public/
.vercel/

# ------------------------------------------------------------------ #
# Editors / OS
# ------------------------------------------------------------------ #
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
