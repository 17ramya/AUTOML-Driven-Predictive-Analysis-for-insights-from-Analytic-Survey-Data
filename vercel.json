{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python scripts/prepare_vercel_site.py",
  "installCommand": "python -m pip install -r deploy/vercel/requirements-api.txt",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 300,
      "includeFiles": "**/*",
      "excludeFiles": "{public/**,tests/**,docs/**,notebooks/**,.vscode/**}"
    }
  },
  "headers": [
    {
      "source": "/stlite/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/stlite-config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
